# Copy to .env (never commit .env). All values are optional: with none set the
# app runs in clearly-labelled DEMO mode with a simulated timetable.

# --- Live data: National Rail Darwin "Live Departure Board" (LDBWS) ---------
# Register at https://raildata.org.uk, subscribe to "Live Departure Board"
# (LDBWS), and paste the *consumer key* from the product's Specification tab.
DARWIN_API_KEY=
# Base URL shown on the RDM product page (override if yours differs).
# DARWIN_BASE_URL=https://api1.raildata.org.uk/1010-live-departure-board-dep/LDBWS/api/20220120

# --- Scheduled timetable (any date): Network Rail SCHEDULE feed --------------
# Register at https://publicdatafeeds.networkrail.co.uk (free), then run:
#   npm run timetable:import -- --download
# or download the CIF JSON full extract yourself and run:
#   npm run timetable:import -- --file path/to/toc-full.json.gz
NROD_USERNAME=
NROD_PASSWORD=
# CRS codes of your home, work and change stations (add any others you use).
TIMETABLE_STATIONS=WOK,WAT,CLJ
# TIMETABLE_FILE=data/timetable.json

# --- Server ------------------------------------------------------------------
PORT=8787
# HOST=0.0.0.0
# Protect a public deployment (strongly recommended — it guards your API quota).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Extra England & Wales bank holidays (comma-separated YYYY-MM-DD).
# BANK_HOLIDAYS=2028-01-03

# --- Demo / testing ----------------------------------------------------------
# DEMO_MODE=true            # force demo even with credentials
# DEMO_SCENARIO=disrupted   # simulated delays/cancellations to preview warnings
# DEMO_LATENCY_MS=1500      # simulate a slow upstream
# RESPONSE_CACHE_MS=15000   # server-side response cache (0 disables)
