{
  "name": "rail-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Personal mobile-first UK National Rail commute dashboard (GO TO WORK / GO HOME).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/server/main.ts",
    "dev": "node scripts/build.mjs && node --watch src/server/main.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "check": "npm run typecheck && npm test && npm run build",
    "timetable:import": "node src/server/timetable/import-cli.ts",
    "measure": "node scripts/measure.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "uk-railway-stations": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright-core": "1.56.1",
    "typescript": "~5.9.0"
  }
}
