# Claude Workspace — gitignore

# Archive folders (personal history — don't push to public repos)
notes/archive/
planner/archive/
tasks/archive/
tracker/archive/

# Actual note and plan content (personal — keep local)
notes/*.md
planner/today.md
tasks/tasks.md
tracker/items.md

# Keep the structure and skills — those are the reusable parts
# Remove lines above if you WANT to track your content in git

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp

# Garmin — credentials, tokens and personal plans stay local
garmin/.env
garmin/.garminconnect/
garmin/uploads.md
garmin/plans/*.yaml
garmin/plans/incoming/*
!garmin/plans/incoming/.gitkeep
garmin/plans/archive/*
!garmin/plans/archive/.gitkeep
__pycache__/
.pytest_cache/
